# --- Local-only context (never on GitHub) ---
# The photographs, everything derived from them, and the working notes that
# name them stay local. The design reasoning that used to live in CLAUDE.md
# and DECISIONS.md is public now, distilled into ARCHITECTURE.md and docs/.
/source-files/*
!/source-files/.gitkeep
/HANDOVER.md

# --- Personal photo archive: sources, derivatives, sidecars ---
# CRITICAL (initial-prompt note 15): no personal image, audio, or sidecar
# may ever be committed. These rules are belt-and-braces on top of the
# folder rules above.
/output/
/archive/
/sharing/
/report/
/data/
*.fpx
*.fpx.json
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.wav
*.pez
manifest.json
audit_report.json
conversion.log

# --- Test fixtures are the ONE exception ---
# Non-personal, committed FPX fixtures for tier-1/2 tests live here.
!/tests/fixtures/**

# --- Documentation screenshots ---
# Screenshots of the application window, for README.md and docs/. Narrow on
# purpose: only *.png, only directly inside docs/images/, and nothing else
# above is weakened. A photograph cannot reach the repository through this --
# .fpx, .tif, .jpg and every other image rule still apply everywhere, and the
# leakage guards in tests/test_environment.py list untracked files too.
!/docs/images/*.png

# --- Secrets and runtime data ---
.env
*.env.local
*.log
*.db

# --- Language/tool clutter ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
build/
# PyInstaller writes a .spec beside whatever it is told to build. The one in
# packaging/ is hand-written and is the build definition, not output.
*.spec
!/packaging/*.spec
*.tsbuildinfo

# --- Scratch ---
scratch/
logs/

# --- OS/editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Harness-managed sub-agent worktrees. Transient, and never part of the
# repository -- but they must be ignored explicitly, because the leakage
# guards list untracked files and would otherwise scan a whole second
# checkout.
.claude/worktrees/

# PyInstaller licence-guard scratch builds
/build-*/
/dist-*/

# Wiki content staged for the separate GitHub wiki repo, never part of this one
/wiki-staging/
